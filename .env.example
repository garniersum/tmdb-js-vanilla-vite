# TMDB API Configuration
# Copia este archivo a .env.local y agrega tu API key real.
# El prefijo VITE_ es obligatorio: es el nombre que lee js/config/tmdb.config.js.
#
# ADVERTENCIA: toda variable VITE_* se incluye en el bundle del navegador y es
# pública. Usa una API key de solo lectura de TMDB y rótala si se filtra. Para
# mantenerla secreta, haz las peticiones desde un proxy en el servidor.
VITE_TMDB_API_KEY=your_api_key_here
